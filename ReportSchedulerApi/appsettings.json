  "SchedulerWorker": {
    "Enabled": true,
    "CheckEverySeconds": 60,

    // How far back the scheduler will replay occurrences it missed while the
    // application was not running. Covers an app-pool recycle or a short
    // outage; bounded so a multi-day outage does not fire a backlog of
    // notifications the moment the app returns. Set 0 to disable catch-up.
    "CatchUpWindowMinutes": 120,

    // /health/scheduler reports Stalled (HTTP 503) once the minutely sweep
    // has not run for this long. The watchdog uses it to recycle the pool.
    "StalledAfterMinutes": 10
  },

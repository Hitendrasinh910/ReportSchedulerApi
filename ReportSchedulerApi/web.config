<?xml version="1.0" encoding="utf-8"?>
<!--
    processPath and arguments are rewritten by `dotnet publish`; leave the
    placeholders alone.

    stdoutLogEnabled is on deliberately. When the app pool recycles and the
    application fails to come back, the ASP.NET Core Module writes the reason
    here -- which is the only place a startup failure (unreachable SQL Server,
    bad connection string, missing runtime) is recorded. Logs land in
    .\logs\stdout_*.log next to the published files; make sure the app pool
    identity can write to that folder.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>

      <aspNetCore processPath="%LAUNCHER_PATH%"
                  arguments="%LAUNCHER_ARGS%"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>

      <!--
          The scheduler holds no session state, so there is nothing to lose
          on recycle; the value of these is only that fewer recycles means
          fewer windows where the app is not dispatching.
      -->
      <security>
        <requestFiltering>
          <!-- PDF payloads are base64-inlined into notification calls. -->
          <requestLimits maxAllowedContentLength="52428800" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
